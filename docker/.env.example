# Stream URLs Configuration
# Primary streams (from mediamtx WebRTC->RTSP bridge)
# Cloudflare Access-protected Pi API and service token for SFU signaling
PI_API_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional Cloudflare Realtime TURN credentials for direct SFU media connectivity.
# Keep separate from the Cloudflare Access service token above.
# Example TLS/TCP fallback: turns:turn.cloudflare.com:443?transport=tcp
CF_SFU_TURN_URLS=
CF_SFU_TURN_USERNAME=
CF_SFU_TURN_CREDENTIAL=

STREAM_1_PRIMARY_URL=rtsp://rtsp-server:8554/cam1
STREAM_2_PRIMARY_URL=rtsp://rtsp-server:8554/cam2

# Backup streams (activated when primary fails) - use same bridge paths or backups
STREAM_1_BACKUP_URL=rtsp://rtsp-server:8554/cam1
STREAM_2_BACKUP_URL=rtsp://rtsp-server:8554/cam2

# Output streams (H.264 encoded)
STREAM_1_OUTPUT_URL=rtsp://rtsp-server:8554/stream1
STREAM_2_OUTPUT_URL=rtsp://rtsp-server:8554/stream2

# Model weights (path inside pipeline container; Dockerfile copies weights/ here)
MODEL_PATH=/app/weights/best.pt

# GPU support
USE_GPU=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ByteTrack settings
ENABLE_TRACKING=true
TRACK_THRESH=0.5
TRACK_BUFFER=30
MATCH_THRESH=0.8

# Evidence upload to NestJS (R3) - multipart
EVIDENCE_UPLOAD_ENABLED=true
# e.g. http://host.docker.internal:3000 or your NestJS server
EVIDENCE_API_BASE_URL=http://host.docker.internal:3000
EVIDENCE_UPLOAD_TOKEN=
INCIDENT_ID=
# Clip from start of detection after N seconds of no detection
EVIDENCE_NO_DETECT_TIMEOUT=5.0
EVIDENCE_PRE_BUFFER_SECONDS=10.0
# NVDEC decode for hardware accel
EVIDENCE_USE_NVDEC=true
# TURN server for WebRTC/RTSP over TURN if needed (Pis use this to reach mediamtx)
USE_TURN=true
TURN_SERVER=turn:your-turn-server:3478
TURN_USERNAME=
TURN_PASSWORD=
