FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir aiortc==1.9.0 requests
COPY scripts/sfu_subscriber.py /app/sfu_subscriber.py
ENV PYTHONUNBUFFERED=1
CMD ["python", "/app/sfu_subscriber.py"]
